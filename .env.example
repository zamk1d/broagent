# ── Переключатель провайдера ────────────────────────────────────────────
# "groq"      — для быстрых/дешёвых тестов во время разработки
# "anthropic" — то, что нужно для финальной сдачи (Claude)
# Меняется одной строкой, код трогать не нужно.
BROAGENT_PROVIDER=groq

# ── Anthropic (нужен, если BROAGENT_PROVIDER=anthropic) ─────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ── Groq (нужен, если BROAGENT_PROVIDER=groq) ────────────────────────────
GROQ_API_KEY=gsk...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ── Общее ─────────────────────────────────────────────────────────────
BROAGENT_PROFILE_DIR=./profile
BROAGENT_START_URL=https://www.google.com/
BROAGENT_MAX_STEPS=30
